{
  "name": "ttot",
  "private": true,
  "version": "0.1.0",
  "description": "浏览器内的 GeoTIFF 围栏网格与处方图工具：绘制围栏、生成网格、聚合像元，导出 GeoJSON 与带处方波段的裁剪 GeoTIFF。",
  "license": "MIT",
  "keywords": [
    "geotiff",
    "precision-agriculture",
    "prescription-map",
    "variable-rate",
    "openlayers",
    "react",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "geotiff": "^2.1.3",
    "ol": "^10.6.1",
    "proj4": "^2.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
