# 依赖与构建产物
node_modules/
# git worktree 里常用软链复用主检出的依赖，需一并忽略（上面的 node_modules/ 只匹配目录）
node_modules
dist/
coverage/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# 包管理器
# .pnpm-store 是本地缓存目录，不应入库
package-lock.json
.pnpm-store/

# 本地数据与工作副本
data/
.worktrees/

# 工具与调试产物
.ace-tool/
.sisyphus/
.tmp-shots/
vite.config.local.ts

# 编辑器与系统
.DS_Store
*.log

# 影像原始数据（禁止入库）
*.tif
*.tiff
